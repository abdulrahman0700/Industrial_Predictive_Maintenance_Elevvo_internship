FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/api

# System library LightGBM needs (the libgomp.so.1 error)
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /api

# Dependencies first, so this layer is cached when only code changes
COPY docker/requirements.api.txt .
RUN pip install -r requirements.api.txt

# Application code and trained models
COPY api/ ./api/
COPY src/ ./src/
COPY LLM/ ./LLM/
COPY models_artifacts/ ./models_artifacts/

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]